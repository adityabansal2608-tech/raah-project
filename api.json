{
  "name": "Raahi - Fully Integrated Safety & Road Intelligence Workflow",
  "nodes": [
    {
      "parameters": {
        "options": {}
      },
      "id": "11111111-1111-1111-1111-111111111111",
      "name": "When chat message received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [ -1280, 64 ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.chatInput }}",
              "operation": "regex",
              "value2": "(help|i am not safe|someone is following me|emergency|sos|danger)"
            }
          ]
        }
      },
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "Is Emergency?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [ -1040, 64 ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "sos-response",
              "name": "output",
              "value": "🚨 **EMERGENCY ALERT TRIGGERED** 🚨\n\nIf you are in immediate danger, please reach out to emergency services right away:\n- **Police Emergency**: Call 112 / 911\n- **Women Safety Helpline**: Call 1091\n\nTap this link to share your live location:\nhttps://profound-squirrel-b7d1af.netlify.app/location.html",
              "type": "string"
            }
          ]
        }
      },
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "Instant SOS Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [ -800, -100 ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput }}",
        "options": {
          "systemMessage": "You are Raahi, an AI Route Safety Intelligence Assistant.\n\nGuidance:\n1. Use the 'Get_Live_Traffic_Data' tool whenever the user asks about live traffic conditions, delays, or congestion on a route.\n2. Use the 'Fetch_Live_Safety_Data' tool for crime reports, weather hazards, or accidents.\n3. Always evaluate traveler safety clearly and give practical advice."
        }
      },
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "Raahi Safety AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [ -800, 160 ]
    },
    {
      "parameters": {
        "model": "llama-3.3-70b-versatile",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "55555555-5555-5555-5555-555555555555",
      "name": "Groq Llama 3.3 70B",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [ -940, 380 ]
    },
    {
      "parameters": {
        "sessionKey": "={{ $json.sessionId || 'default-session' }}",
        "contextWindowLength": 20
      },
      "id": "66666666-6666-6666-6666-666666666666",
      "name": "Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [ -800, 380 ]
    },
    {
      "parameters": {
        "name": "Fetch_Live_Safety_Data",
        "description": "Fetch live safety data, crime reports, and road incidents for a specified location.",
        "url": "https://api.serper.dev/search",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-KEY",
              "value": "YOUR_SERPER_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"q\": \"{{ $fromAI('query', 'search query for location safety, crime reports, or accidents') }}\"\n}"
      },
      "id": "77777777-7777-7777-7777-777777777777",
      "name": "Live Search Tool",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [ -660, 380 ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "e623f81a-2324-46d4-81fa-8e71bd7a880b",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "d0318fcd-9675-472c-934c-bc2e17f31d87",
      "name": "Webhook1",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [ -560, 600 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://overpass-api.de/api/interpreter",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/plain",
        "body": "=[out:json][timeout:25];\nnwr[\"amenity\"=\"police\"](around:20000,{{ $json.body.destination.lat }},{{ $json.body.destination.lon }});\nout center;",
        "options": {
          "timeout": 30000
        }
      },
      "id": "97ef13a5-461d-4e9f-9cf2-17ed53da2d53",
      "name": "HTTP Request2",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [ -340, 600 ]
    },
    {
      "parameters": {
        "url": "https://api.openweathermap.org/data/2.5/weather",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "lat",
              "value": "={{$json.body.destination.lat}}"
            },
            {
              "name": "lon",
              "value": "={{$json.body.destination.lon}}"
            },
            {
              "name": "units",
              "value": "metric"
            },
            {
              "name": "appid",
              "value": "={{ $env.OPENWEATHER_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "66d2d8b8-e0ca-4d44-a0a1-1b787daee21e",
      "name": "weather",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [ -120, 600 ]
    },
    {
      "parameters": {
        "url": "=https://api.tomtom.com/routing/1/calculateRoute/{{ $('Webhook1').item.json.body.origin.lat }},{{ $('Webhook1').item.json.body.origin.lon }}:{{ $('Webhook1').item.json.body.destination.lat }},{{ $('Webhook1').item.json.body.destination.lon }}/json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "cx5JTJbP0wWXckRR2zjvTfUmK0fxYOkE"
            },
            {
              "name": "traffic",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
      "id": "99999999-9999-9999-9999-999999999999",
      "name": "TomTom Route Traffic",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [ 100, 600 ]
    },
    {
      "parameters": {
        "jsCode": "const overpass = $('HTTP Request2').first().json;\nconst weather = $('weather').first().json;\nconst tomtom = $('TomTom Route Traffic').first()?.json?.routes?.[0]?.summary;\n\n// 1. Weather\nconst temp = weather.main?.temp ?? 0;\nconst rain = weather.rain?.[\"1h\"] ?? 0;\nconst visibility = weather.visibility ?? 10000;\nconst condition = weather.weather?.[0]?.main ?? \"Clear\";\n\n// 2. Traffic Delays from TomTom\nconst delaySeconds = tomtom?.trafficDelayInSeconds ?? 0;\nconst delayMin = Math.round(delaySeconds / 60);\n\nlet trafficStatus = \"Normal\";\nif (delayMin > 15) {\n    trafficStatus = \"Heavy\";\n} else if (delayMin > 5) {\n    trafficStatus = \"Moderate\";\n}\n\n// 3. Dynamic Best Departure Calculation\nlet departure = \"Leave Now\";\nif (trafficStatus === \"Heavy\") {\n    departure = \"Wait 30-45 min (Heavy Traffic)\";\n} else if (rain > 2) {\n    departure = \"Wait for rain to clear\";\n} else {\n    departure = \"Ideal time to leave now\";\n}\n\n// 4. Police Proximity\nconst policeCount = overpass.elements ? overpass.elements.length : 0;\n\n// 5. Dynamic Safety Score\nlet score = 10;\nlet reason = \"Good weather and manageable road conditions.\";\n\nif (delayMin > 10) {\n    score -= 1.5;\n    reason = \"Traffic delays reported on route.\";\n}\nif (rain > 0) {\n    score -= 1.5;\n    reason = \"Rain expected on this route.\";\n}\nif (visibility < 5000) {\n    score -= 1.0;\n    reason = \"Low visibility on route.\";\n}\nif (policeCount < 2) {\n    score -= 0.5;\n}\n\nscore = Math.max(score, 1).toFixed(1);\n\nreturn [{\n    json: {\n        score,\n        reason,\n        weather: condition,\n        temperature: `${Math.round(temp)}°C`,\n        rain: `${rain} mm`,\n        visibility: `${Math.round(visibility / 1000)} km`,\n        traffic: trafficStatus,\n        delay: delayMin > 0 ? `${delayMin} min` : \"0-5 min\",
        route: \"Recommended Route\",\n        departure: departure\n    }\n}];"
      },
      "id": "2511792d-1998-4ff8-95fc-17d90741630a",
      "name": "Code in JavaScript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 320, 600 ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "a50a2feb-cce6-402c-8086-5479adcaff36",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [ 540, 600 ]
    }
  ],
