      "id": "ceaffef4-d501-4037-9675-b91817dd4317",
      "name": "TomTom Route Traffic",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        912,
        704
      ]
    },
    {
      "parameters": {
        "jsCode": "const overpass = $('HTTP Request2').first()?.json || {};\nconst weather = $('weather').first()?.json || {};\nconst tomtom = $('TomTom Route Traffic').first()?.json?.routes?.[0]?.summary;\n\nconst temp = weather.main?.temp ?? 28;\nconst rain = weather.rain?.[\"1h\"] ?? 0;\nconst visibility = weather.visibility ?? 10000;\nconst condition = weather.weather?.[0]?.main ?? \"Clear\";\n\n// Fallback safety if TomTom times out or returns null\nconst delaySeconds = tomtom?.trafficDelayInSeconds ?? 120; // Defaults to a safe 2-min estimate if API fails\nconst delayMin = Math.round(delaySeconds / 60);\n\nlet trafficStatus = \"Normal\";\nif (delayMin > 5) {\n    trafficStatus = \"Heavy\";\n} else if (delayMin > 1) {\n    trafficStatus = \"Moderate\";\n}\n\nconst policeCount = overpass.elements ? overpass.elements.length : 2;\n\nlet score = 8.5;\nlet reason = \"Route conditions are stable.\";\n\nif (delayMin > 5) {\n    score -= 1.5;\n    reason = \"Moderate to heavy congestion detected on route.\";\n}\nif (rain > 0) {\n    score -= 1.0;\n    reason = \"Wet road conditions due to light weather.\";\n}\n\nscore = Math.max(score, 1).toFixed(1);\n\nreturn [{\n    json: {\n        score,\n        reason,\n        weather: condition,\n        temperature: `${Math.round(temp)}°C`,\n        rain: `${rain} mm`,\n        visibility: `${Math.round(visibility / 1000)} km`,\n        traffic: trafficStatus,\n        delay: `${delayMin} min`,\n        route: \"Optimized Route\",\n        departure: trafficStatus === \"Heavy\" ? \"Consider waiting 20 mins\" : \"Ideal time to leave\"\n    }\n}];"
      },
